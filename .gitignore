# Credentials and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Python and editor/runtime state
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Model/evaluation runtime state
*.eval
*.log
*.log.gz
*.tmp
*.bak
*.sqlite
*.db
runtime/
runtime-localappdata/
localappdata-*/
logs/
traces/
cache/
output_data/

# Upstream repositories and their datasets are dependencies, not project source.
# They are installed or cloned separately at the pinned revisions documented in
# THIRD_PARTY_NOTICES.md; no upstream code or data is redistributed here.
/MemSyco-Bench/
/inspect_evals/

# Exclude all raw experimental material by default. The selected manifests,
# summaries and reports below are aggregate evidence only (no benchmark rows,
# prompts, model completions, or judge transcripts).
